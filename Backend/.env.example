# Copy this file to `.env` and fill in real values.
# Never commit `.env`: it is listed in .gitignore.

# Port the API listens on.
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or a local MongoDB server).
# Atlas example:  mongodb+srv://<user>:<password>@<cluster-host>/code2chill?retryWrites=true&w=majority
# Local example:  mongodb://127.0.0.1:27017/code2chill
MONGODB_URI=

# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login token stays valid (e.g. 1h, 7d).
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call the API, comma-separated, no trailing slash.
# 5173 = `npm run dev`, 4173 = `npm run preview`.
# Add your Vercel URL here when the frontend is deployed, e.g.
#   CLIENT_ORIGIN=https://code2chill.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
