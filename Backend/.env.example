# Copy this file to `.env` and fill in real values.
# Never commit `.env`: it is listed in .gitignore. This example must never
# contain real credentials.

# Port the API listens on.
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string. See README.md → "MongoDB Atlas setup".
# Atlas format (replace <db_username>, <db_password> AND the < > brackets;
# copy the real cluster host from Atlas → Connect → Drivers):
#   mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# Local MongoDB:
#   mongodb://127.0.0.1:27017
# If the password has special characters (@ : / ? # [ ] %), URL-encode them
# (e.g. @ becomes %40) or create a password using only letters and numbers.
MONGODB_URI=

# Database name inside the cluster (optional, default: code2chill).
# This is used even if the connection string names a different database.
MONGODB_DB_NAME=code2chill

# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login token stays valid (e.g. 1h, 7d).
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call the API, comma-separated, no trailing slash.
# 5173 = `npm run dev`, 4173 = `npm run preview`.
# Add your Vercel URL here when the frontend is deployed, e.g.
#   CLIENT_ORIGIN=https://code2chill.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
