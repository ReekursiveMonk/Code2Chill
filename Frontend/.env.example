# Copy to `.env` (or `.env.local`) for local development.
# Only variables starting with VITE_ are exposed to the browser, so never
# put secrets here. This is just the public address of the backend API.

# Local backend (Backend/ running with `npm run dev`):
VITE_API_URL=http://localhost:5000

# In production, set VITE_API_URL in the Vercel project settings to your
# deployed backend URL, e.g. https://code2chill-api.example.com
